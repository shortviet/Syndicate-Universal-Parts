-- Launch Game Script
-- ═══════════════════════════════════════════════════════════════
local function launchGameScript(langCode)
    getgenv().Syndicate_Hub_Language = langCode
    
    local ok, data = pcall(readfile, "dropdowns.json")
    if ok and data then
        local json = game:GetService("HttpService"):JSONDecode(data)
        local savedName = json and json["LanguageSetting"]
        if not savedName then
            local NameMap = {
                en = "English",
                ar = "Arabic",
                es = "Española",
                tr = "Turkey",
                ru = "Russian",
                fr = "France",
                de = "Germany",
                pt = "Brazil"
            }
            saveLanguageSetting(NameMap[langCode] or "English")
        end
    end

    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Syndicate Hub",
        Text = "The Script Will Be Load...",
        Duration = 3
    })

    local scriptUrl = "https://raw.githubusercontent.com/shortviet/Syndicate-Universal-Parts/main/HUB/" .. CurrentGame.Script
    pcall(function()
        loadstring(game:HttpGet(scriptUrl))()
    end)
end

