        clickTween.Completed:Wait()

        saveDontShowSetting(dontShowAgain)
        local activeCode = getSavedLanguageCode()
        task.spawn(launchGameScript, activeCode)
        closeMenu()
    end)

    for _, lang in ipairs(Languages) do
