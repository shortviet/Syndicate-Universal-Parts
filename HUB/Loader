    SkipButton.Position = UDim2.new(0.35, 0, 0.88, 0)
    SkipButton.Size = UDim2.new(0.3, 0, 0.08, 0)
    SkipButton.Font = Enum.Font.GothamMedium
    SkipButton.TextColor3 = Colors.textDim
    SkipButton.TextScaled = true
    SkipButton.Visible = false

    addCorner(8, SkipButton)
    addStroke(Colors.border, 1, SkipButton)

    applyHoverEffect(SkipButton, Colors.surfaceLight, Colors.surfaceLight)

    SkipButton.MouseButton1Click:Connect(function()
