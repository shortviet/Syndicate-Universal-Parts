    AnimationsButton.Position = UDim2.new(0.54, 0, 0.62, 0)
    AnimationsButton.Size = UDim2.new(0.38, 0, 0.22, 0)
    AnimationsButton.Font = Enum.Font.GothamBold
    AnimationsButton.Text = "Animations"
    AnimationsButton.TextColor3 = Colors.white
    AnimationsButton.TextScaled = true
    AnimationsButton.BackgroundColor3 = Colors.surfaceLight

    addCorner(12, AnimationsButton)
    addStroke(Colors.border, 1.5, AnimationsButton)

    applyHoverEffect(AnimationsButton, Colors.surfaceLight, Colors.surfaceLight)

    AnimationsButton.MouseButton1Click:Connect(function()
        local clickTween = tw(AnimationsButton, 0.1, {
