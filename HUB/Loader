local function applyHoverEffect(button, defaultColor, hoverColor)
    button.MouseEnter:Connect(function()
        tw(button, 0.2, {
            BackgroundColor3 = hoverColor
        })
        if button:FindFirstChild("UIStroke") then
            tw(button.UIStroke, 0.2, {Color = Colors.accent})
        end
    end)
    button.MouseLeave:Connect(function()
        tw(button, 0.2, {
            BackgroundColor3 = defaultColor
        })
        if button:FindFirstChild("UIStroke") then
            tw(button.UIStroke, 0.2, {Color = Colors.border})
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- Dragging System
-- ═══════════════════════════════════════════════════════════════
local function makeDraggable(frame, handle)
    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputState == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

makeDraggable(MainFrame, SPHub)

