-- ═══════════════════════════════════════════════════════════════
-- Discord AD Blocker (Enhanced - scans all GUI hierarchies)
-- ═══════════════════════════════════════════════════════════════
local DiscordKeywords = {
    "discord.gg", "discord.com/invite", "Join our Discord",
    "join our Discord", "Join Our Discord", "Join Our Server",
    "join our server", "Join our server", "SP Hub", "SP_Hub",
    "SPHub", "as6cd0", "sirius", "whitelist", "Whitelist",
    "WHITELIST", "WhitelistedMouse", "adScreen", "AdScreen",
    "Countdown", "countdown", "discord.app", "Premium"
}

local function isDiscordAD(obj)
    if not obj then return false end
    pcall(function()
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = string.lower(obj.Text or "")
            for _, kw in ipairs(DiscordKeywords) do
                if string.find(text, string.lower(kw)) then return true end
            end
        end
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            local img = string.lower(obj.Image or "")
            if string.find(img, "discord") or string.find(img, "whitelist") then
                return true
            end
        end
    end)
    return false
end

local function scanAndDestroy(parent)
    for _, gui in ipairs(parent:GetChildren()) do
        if gui:IsA("ScreenGui") then
            local shouldDestroy = false
            pcall(function()
                for _, desc in ipairs(gui:GetDescendants()) do
                    if isDiscordAD(desc) then
                        shouldDestroy = true
                        break
                    end
                end
            end)
            if shouldDestroy then
                gui:Destroy()
            end
        end
    end
end

local function hookAllScreenGuis(parent)
    pcall(function()
        for _, gui in ipairs(parent:GetChildren()) do
            if gui:IsA("ScreenGui") then
                gui.DescendantAdded:Connect(function(desc)
                    task.wait(0.1)
                    if isDiscordAD(desc) then
                        pcall(function() gui:Destroy() end)
                    end
                end)
            end
        end
        parent.ChildAdded:Connect(function(child)
            task.wait(0.2)
            pcall(function()
                if child:IsA("ScreenGui") then
                    child.DescendantAdded:Connect(function(desc)
                        task.wait(0.1)
                        if isDiscordAD(desc) then
                            pcall(function() child:Destroy() end)
                        end
                    end)
                    for _, desc in ipairs(child:GetDescendants()) do
                        if isDiscordAD(desc) then
                            child:Destroy()
                            return
                        end
                    end
                end
            end)
        end)
    end)
end

-- Initial scan + hooks
scanAndDestroy(PlayerGui)
scanAndDestroy(CoreGui)
hookAllScreenGuis(PlayerGui)
hookAllScreenGuis(CoreGui)

