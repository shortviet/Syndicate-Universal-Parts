    end)
end

-- ═══════════════════════════════════════════════════════════════
-- Loading Sequence (SU-Menu Style)
-- ═══════════════════════════════════════════════════════════════
local function runLoadingSequence()
    -- Show loading frame with glow
    LoadingFrame.Visible = true
    GlowFrame.Visible = true

    -- Animate glow pulse
    task.spawn(function()
        while GlowFrame and GlowFrame.Parent do
            local pulse = 0.85 + math.sin(tick() * 2) * 0.03
            GlowFrame.BackgroundTransparency = pulse
            task.wait(0.05)
        end
    end)

    -- Open animation
    local openTween = tw(LoadingFrame, 0.5, {
        Size = UDim2.new(0.3, 0, 0.3, 0)
    }, Enum.EasingStyle.Back)

    -- Glow follows
    tw(GlowFrame, 0.5, {
        Size = UDim2.new(0.33, 0, 0.33, 0)
    }, Enum.EasingStyle.Back):Play()

    openTween:Play()
    openTween.Completed:Wait()

    -- Show logo with fade
    LoadingLogo.Visible = true
    LoadingLogo.ImageTransparency = 1
    tw(LoadingLogo, 0.4, {ImageTransparency = 0}):Play()
    task.wait(1.2)

    -- Fade out logo
    tw(LoadingLogo, 0.4, {ImageTransparency = 1}):Play()
    task.wait(0.4)

    -- Fade out loading frame
    tw(LoadingFrame, 0.5, {BackgroundTransparency = 1}):Play()
    tw(GlowFrame, 0.5, {BackgroundTransparency = 1}):Play()
    task.wait(0.5)
    LoadingFrame.Visible = false
    GlowFrame.Visible = false

    -- Slide in main menu
    MainFrame.Visible = true
    tw(MainFrame, 0.6, {
        Position = UDim2.new(0.5, 0, 0.5, 0)
    }, Enum.EasingStyle.Back):Play()
end

task.spawn(runLoadingSequence)